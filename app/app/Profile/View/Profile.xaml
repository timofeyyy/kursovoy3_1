<UserControl x:Class="app.app.Profile.View.Profile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:app.app.Profile.View"
             xmlns:utils="clr-namespace:app.utils"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="622"
             Style="{StaticResource Page_Style}"
             >
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.75*"/>
            <ColumnDefinition Width="5*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1.75*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.1*"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="0.4*"/>
            <RowDefinition Height="14*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="Profile" Style="{StaticResource EntryTB}" HorizontalAlignment="Left"/>

        <Border HorizontalAlignment="Left" CornerRadius="20" Width="250" Height="250" Background="LightGray" VerticalAlignment="Top" Grid.Column="1" Grid.Row="3">
            <Border.Clip>
                <RectangleGeometry Rect="0,0,250,250" RadiusX="125" RadiusY="125"/>
            </Border.Clip>
            <Grid>
                <Image Source="{Binding UserImage}" Stretch="Fill"/>
            </Grid>
        </Border>

        <Grid Grid.Column="2" Grid.Row="3" HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Change your profile" Style="{StaticResource EntryTB}" FontSize="20"  VerticalAlignment="Top"/>
                <StackPanel Orientation="Vertical" Margin="10,20,0,20">
                    <TextBlock Text="image" Style="{StaticResource ParamTB}" Margin="0" />
                    <Border Background="#ED9D2E" CornerRadius="5" Margin="0, 10 ,0 ,0" Width="70" Padding="5" HorizontalAlignment="Left">
                        <Button Content="Load" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding ChangeImageCommand}" />
                        
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10,0,0,20">
                    <TextBlock Text="emial" Style="{StaticResource ParamTB}" Margin="0" />
                    <Border Margin="0, 10 ,0 ,0" BorderThickness="0,0,0,2" BorderBrush="White"  >
                        <TextBox Grid.Column="0" Style="{StaticResource ParamBorderTB}" CaretBrush="White" Margin="0" Padding="0,0,0,5" Foreground="White" FontWeight="Thin" FontSize="15" Text="{Binding Email}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10,0,0,20">
                    <TextBlock Text="login" Style="{StaticResource ParamTB}" Margin="0" />
                    <Border Margin="0, 10 ,0 ,0" BorderThickness="0,0,0,2" BorderBrush="White"  >
                        <TextBox Grid.Column="0" Style="{StaticResource ParamBorderTB}" CaretBrush="White" Margin="0" Padding="0,0,0,5" Foreground="White" FontWeight="Thin" FontSize="15" Text="{Binding UserName}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Vertical" Margin="10,0,0,20">
                    <TextBlock Text="password" Style="{StaticResource ParamTB}" Margin="0" />
                    <Border Margin="0, 10 ,0 ,0" BorderThickness="0,0,0,2" BorderBrush="White"  >
                        <PasswordBox utils:PasswordHelper.BoundPassword="{Binding Password}" Grid.Column="0" Style="{StaticResource ParamBorderPB}" CaretBrush="White" Margin="0" Padding="0,0,0,5" Foreground="White" FontWeight="Thin" FontSize="15" />
                    </Border>
                </StackPanel>
                <Border Background="#ED9D2E" CornerRadius="2" Margin="0, 60 ,0 ,0" Width="90" HorizontalAlignment="Right">
                    <Button Content="Edit" Margin="0" Width="90" Height="35"  Style="{StaticResource NoHoverButtonStyle}" Command="{Binding EditCommand}"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
