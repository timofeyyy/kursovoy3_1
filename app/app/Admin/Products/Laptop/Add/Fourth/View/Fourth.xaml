<UserControl x:Class="app.app.Admin.Products.Laptop.Add.Fourth.View.Fourth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:app.app.Admin.Products.Laptop.Add.Fourth.View"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource Page_Style}" >
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="1" Text="Short preview before adding" Style="{StaticResource EntryTB}" HorizontalAlignment="Left" />

        <!--<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Width="780" Height="300" HorizontalAlignment="Left">-->

            <Grid Grid.Row="2" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Width="230" Height="230" HorizontalAlignment="Left" VerticalAlignment="Top" Grid.Row="0">
                    <Border Background="Gray" CornerRadius="20"  Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                        <Border.Clip>
                            <RectangleGeometry Rect="0,0,230,230" RadiusX="10" RadiusY="10"/>
                        </Border.Clip>
                        <Image Source="{Binding CurrentImage}" Stretch="UniformToFill"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.4*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="0.4*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="1">
                            <Image Source="{svg:SvgImage ../../../../../../../res/icons/left.svg}" Height="20" Width="20" />
                            <Button Background="Transparent" Command="{Binding PrevImageCommand}" Style="{StaticResource NoHoverButtonStyle}" Cursor="Hand"/>
                        </Grid>
                        <Grid Grid.Column="3">
                            <Image Source="{svg:SvgImage ../../../../../../../res/icons/right.svg}" Height="20" Width="20" />
                            <Button Background="Transparent" Command="{Binding NextImageCommand}" Style="{StaticResource NoHoverButtonStyle}" Cursor="Hand"/>
                        </Grid>
                    </Grid>
                </Grid>
                <TextBlock  Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" Text="{Binding Description}" Style="{StaticResource Value}" Margin="10, 5, 0, 5" FontWeight="Thin"/>



            <!--<WrapPanel Orientation="Horizontal" Grid.Column="1"  Width="780" VerticalAlignment="Top" Grid.Row="1" HorizontalAlignment="Left" Margin="0,20,0,0">
                    <TextBlock Text="Description" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>-->

                    <!--<StackPanel Orientation="Horizontal">
                        <TextBlock Text="Model" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Producer" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Price" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Screen" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Wheight" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ProcessorBrand" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ProcessorModel" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OS" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Color" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="RAMMemorySize" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SSDMemorySize" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Color" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VideoCardBrand" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="VideoCardModel" Style="{StaticResource ParamTB}" Margin="30, 5, 0, 5"/>
                        <TextBlock Text="Value" Style="{StaticResource ParamTB}" Margin="10, 5, 0, 5" FontWeight="Thin"/>
                    </StackPanel>-->
                <!--</WrapPanel>-->
            </Grid>
        <!--</ScrollViewer>-->
        
      
        <DockPanel Grid.Row="4" Grid.Column="1" >
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Border Grid.Row="1"  Background="#ED9D2E" CornerRadius="5" Width="70" Margin="0,0,20,0" >
                    <Button Content="Prev" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding PrevCommand}" Margin="0,10" Cursor="Hand" />
                </Border>
                <Border Grid.Row="1"  Background="#ED9D2E" CornerRadius="5" Width="70"  >
                    <Button Content="Finish" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding NextCommand}" Margin="0,10" Cursor="Hand" />
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
