<UserControl x:Class="app.app.Admin.Products.Laptop.Add.Third.View.Third"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:app.app.Admin.Products.Laptop.Add.Third.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource Page_Style}"
             >
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0.5*"/>
            <RowDefinition Height="12*"/>
            <RowDefinition Height="0.3*"/>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="15*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="1" Text="Properties" Style="{StaticResource EntryTB}" HorizontalAlignment="Left" />
        <Grid Grid.Row="2" Grid.Column="1">
            <Grid Width="500" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel  Grid.Column="0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="OS" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <ComboBox ItemsSource="{Binding OSList}" SelectedItem="{Binding OS}" Padding="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="OSListVersion" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <ComboBox ItemsSource="{Binding OSListVersion}" SelectedItem="{Binding OSVersion}" Padding="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="RAM memory" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <TextBox Padding="10" Text="{Binding RAM}" />
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="In stock" Style="{StaticResource ParamTB}" Margin="0, 10" />
                        <TextBox Padding="10" Text="{Binding Stock}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="Color" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding Color}" Padding="10"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="SSD memory" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <TextBox Padding="10" Text="{Binding SSD}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="Height" Style="{StaticResource ParamTB}" Margin="0, 10" />
                        <TextBox Padding="10" Text="{Binding Height}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="Price" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <TextBox Padding="10" Text="{Binding Price}" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="Wheight" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <TextBox Padding="10" Text="{Binding Wheight}"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Left" Width="120">
                        <TextBlock Text="Width" Style="{StaticResource ParamTB}" Margin="0, 10"/>
                        <TextBox Padding="10" Text="{Binding Width}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
           
        </Grid>

        <DockPanel Grid.Row="4" Grid.Column="1">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Border Background="#ED9D2E" CornerRadius="5" Width="70" Margin="0,0,20,0" >
                    <Button Content="Prev" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding PrevCommand}" Margin="0,10" Cursor="Hand" />
                </Border> 
                <Border Background="#ED9D2E" CornerRadius="5" Width="70"  >
                    <Button Content="Next" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding NextCommand}" Margin="0,10" Cursor="Hand" />
                </Border>
            </StackPanel>
        </DockPanel>

    </Grid>
</UserControl>



