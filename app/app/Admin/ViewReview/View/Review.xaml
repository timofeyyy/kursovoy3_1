<UserControl x:Class="app.app.Admin.ViewReview.View.Review"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:app.app.Admin.ViewReview.View"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:utils="clr-namespace:app.utils"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Style="{StaticResource Page_Style}" >

    <UserControl.Resources>
        <utils:SvgToDrawingImageConverter x:Key="SvgToDrawingImageConverter" />
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15*"/>
                    <ColumnDefinition Width="2.5*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical" Grid.Column="1" >
                    <StackPanel Orientation="Vertical" Height="{Binding EmailParamHeight}" >
                        <StackPanel Orientation="Horizontal">
                            <Border Background="AliceBlue" Width="40" Height="40">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,40,40" RadiusX="20" RadiusY="20"/>
                                </Border.Clip>
                                <Grid>
                                    <Image Source="{Binding Review.User.UserImage}" Stretch="Fill"/>
                                </Grid>
                            </Border>
                            <TextBlock Style="{StaticResource EntryTB}" Text="{Binding Review.User.Login}" Margin="10,0,0,0" />

                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Stars}" >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5,0">
                                        <Border Background="Transparent" Width="25" Height="25">
                                            <Image Source="{Binding Path, Converter={StaticResource SvgToDrawingImageConverter}}" Stretch="Fill"/>
                                        </Border>
                                        <Border Background="Transparent" Width="25" Height="25">
                                            <Button Style="{StaticResource NoHoverButtonStyle}" Click="SelectStar"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource ParamBorder}">
                            <TextBox Style="{StaticResource ParamBorderTB}" Text="{Binding Review.Message}" Foreground="Black" FontWeight="Medium" Height="200"/>
                        </Border>
                        
                        <StackPanel Orientation="Horizontal">
                           
                            <Border Margin="20"   Background="#ED9D2E" CornerRadius="5" Width="70"  HorizontalAlignment="Left" Visibility="{Binding IsVisibleButton}" >
                                <Button Content="Remove" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding RemoveCommand}" Margin="0,10" Cursor="Hand" />
                            </Border>
                            <Border Margin="20"   Background="#ED9D2E" CornerRadius="5" Width="70"  HorizontalAlignment="Left" Visibility="{Binding IsVisibleButton}" >
                                <Button Content="Back" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding BackCommand}" Margin="0,10" Cursor="Hand" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                   
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>

</UserControl>






