<UserControl x:Class="app.app.Client.Products.View.Products"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:app.app.Client.Products.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
                          Style="{StaticResource Page_Style}"
>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.5*"/>
                <RowDefinition Height="12*"/>
                <RowDefinition Height="0.5*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.75*"/>
                <ColumnDefinition Width="10*"/>
                <ColumnDefinition Width="1.75*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Row="0" Grid.Column="1">
                <DockPanel>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource EntryTB}" HorizontalAlignment="Left"/>

                    <Border Style="{StaticResource ParamBorder}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="120" Margin="0,3,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="75"  Style="{StaticResource ParamBorderTB}" Margin="15, 5, 0, 5" Text="{Binding SearchValue}" />
                            <Grid Width="15" Height="15">
                                <Border>
                                    <Image Source="{svg:SvgImage ../../../../res/icons/magnifier.svg}"  Stretch="Uniform" />
                                </Border>
                                <Border Width="15" Height="15">
                                    <Button Style="{StaticResource NoHoverButtonStyle}" Cursor="Hand" Width="15" Height="15" Margin="0" Command="{Binding FindCommand}"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <!--<Grid HorizontalAlignment="Center">
                        <ItemsControl ItemsSource="{Binding Items}" >
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Orientation="Horizontal" ItemWidth="230" ItemHeight="300"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border MaxWidth="100" MaxHeight="150" MinHeight="300" MinWidth="230"  Padding="10">
                                        <Border.Effect >
                                            <DropShadowEffect ShadowDepth = "2" BlurRadius = "20" Color = "LightGray" />
                                        </Border.Effect >
                                        <StackPanel Background="#C5D0E6">
                                            <Image Source="{Binding MainImage}" MinHeight="160" MaxHeight="80" VerticalAlignment="Top" Stretch="UniformToFill" />
