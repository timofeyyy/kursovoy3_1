                    </Grid>-->
                    <ItemsControl ItemsSource="{Binding Products}" >
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel  HorizontalAlignment="Left" Orientation="Horizontal" ItemWidth="170" ItemHeight="170"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="150" Height="150" Margin="10">
                                    <Border CornerRadius="10" Background="#3f4347">
                                        <StackPanel>
                                            <Image Source="{Binding FirstImage}" Height="100" Stretch="UniformToFill" >
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,150,100" RadiusX="10" RadiusY="10"/>
                                                </Image.Clip>
                                            </Image>

                                            <Border BorderBrush="black" BorderThickness="0,1,0,0">
                                                <StackPanel Margin="10,5" Orientation="Horizontal">
                                                    <StackPanel Orientation="Vertical">
                                                        <TextBlock Text="{Binding Model}" Style="{StaticResource Value}"  Margin="0,2" TextWrapping="Wrap" Foreground="White" Padding="0"/>
                                                        <StackPanel Orientation="Horizontal"  Margin="0,2" >
                                                            <TextBlock Text="{Binding Price}" Style="{StaticResource Value}" Margin="0"  TextWrapping="Wrap" Foreground="White" Padding="0" VerticalAlignment="Center"/>
                                                            <TextBlock Text="BYN" Style="{StaticResource Value}"  Margin="3,0" VerticalAlignment="Center" Padding="0"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                   
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border>
                                        <Button Background="Transparent" Style="{StaticResource NoHoverButtonStyle}" Click="OpenItem" />
                                    </Border>
                                    <Border Width="80" Height="20"  CornerRadius="5" Background="#ED9D2E" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="5">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Text="in stock" Style="{StaticResource ParamTB}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                            <TextBlock Text="{Binding Stock}" Style="{StaticResource ParamTB}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="20" Height="20"  CornerRadius="5" Background="#ED9D2E" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5">
                                        <Image Width="10" Height="10" Source="{svg:SvgImage ../../../../res/icons/favorite.svg}"/>
                                    </Border>
                                    <Border Width="20" Height="20"  CornerRadius="5" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5">
                                        <Button Background="Transparent" Style="{StaticResource NoHoverButtonStyle}" Click="AddOrRemove" />
                                    </Border>
                                    <Border Background="Black" Opacity="0.7" CornerRadius="10" Visibility="{Binding IsVisible}">
                                        <TextBlock Text="Out of sale" Style="{StaticResource ParamTB}" Padding="0" HorizontalAlignment="Center"  VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
