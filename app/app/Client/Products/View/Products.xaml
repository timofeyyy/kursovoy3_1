                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding NameProp}" Name="HotelTextBlock"   Background="Transparent" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Name}"   Background="Transparent"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CountryProp}"   Background="Transparent" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Country}"   Background="Transparent"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding RatingProp}"   Background="Transparent" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Rating}"   Background="Transparent"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PriceProp}"   Background="Transparent" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Price}"   Background="Transparent"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <Button Content="{Binding SeeItem}" Style="{StaticResource ButtonShowCatalog}" Command="New"  CommandParameter="{Binding}"/>
