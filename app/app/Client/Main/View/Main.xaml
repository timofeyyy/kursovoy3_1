<UserControl x:Class="app.app.Client.Main.View.Main"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:app.app.Client.Main.View"
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../../res/styles/Menu.xaml"/>
                <ResourceDictionary Source="../../../../res/styles/Page.xaml"/>
                <ResourceDictionary Source="../../../../res/styles/Text.xaml"/>
                <ResourceDictionary Source="../../../../res/styles/Image.xaml"/>
                <ResourceDictionary Source="../../Products/DataTemplate.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border Background="#212529"
      CornerRadius="20">

            <Border.Effect>
                <BlurEffect Radius="{Binding BgBlur}" KernelType="Gaussian"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="650" />
                </Grid.ColumnDefinitions>



                <Grid HorizontalAlignment="Left" 
                      Width="200"
                      >


                    <Border Background="#272B2F"
                         CornerRadius="20,0,0,20"  />
                    <Menu Background="Transparent" Margin="0,30,0,0" >
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>
                        <MenuItem Header="Home" Foreground="White" Template="{StaticResource Menu_SubMenu_Template}" Command="{Binding HomeCommand}">
                            <MenuItem.Icon>
                                <Image Source="{svg:SvgImage ../../../../res/icons/home.svg}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Profile" Foreground="White" Template="{StaticResource Menu_SubMenu_Template}" Command="{Binding ProfileCommand}" >
                            <MenuItem.Icon>
                                <Image Source="{svg:SvgImage ../../../../res/icons/profile.svg}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Cart" Foreground="White" Template="{StaticResource Menu_SubMenu_Template}" Command="{Binding CartCommand}">
                            <MenuItem.Icon>
                                <Image Source="{svg:SvgImage ../../../../res/icons/cart.svg}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Orders" Foreground="White" Template="{StaticResource Menu_SubMenu_Template}" Command="{Binding OrdersCommand}">
                            <MenuItem.Icon>
                                <Image Source="{svg:SvgImage ../../../../res/icons/bag.svg}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Help" Foreground="White" Template="{StaticResource Menu_SubMenu_Template}" Command="{Binding HelpCommand}">
                            <MenuItem.Icon>
                                <Image Source="{svg:SvgImage ../../../../res/icons/support.svg}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Log out" Foreground="White" Template="{StaticResource Menu_SubMenu_Template}" Command="{Binding LogOutCommand}" >
                            <MenuItem.Icon>
                                <Image Source="{svg:SvgImage ../../../../res/icons/log-out.svg}"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </Menu>
                </Grid>

                <Grid Grid.Column="1" Margin="0,30,0,0">
                    <ContentControl x:Name="Pages"
                                 Content="{Binding CurrentView}" />
                </Grid>

            </Grid>
        </Border>
        <Grid Height="{Binding DiagHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="1" Grid.Row="1" Background="#272B2F" CornerRadius="20" Padding="0,20,0,20">
                <Grid>
                    
                    
                    <TextBlock Text="{Binding DiagMessage}" Foreground="White" HorizontalAlignment="Center" Grid.Column="1" FontSize="8" Style="{StaticResource ParamTB}" FontWeight="Thin"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="1" Grid.Row="1" CornerRadius="5" Background="#825ae7" >
                            <Button Content="Ок" Command="{Binding DiagCloseCommand}" Foreground="White" Style="{StaticResource NoHoverButtonStyle}" />
                        </Border>

                    </Grid>
                </Grid>
                
            </Border>
        </Grid>
    </Grid>
</UserControl>
