<UserControl x:Class="app.app.Login.View.LogIn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
             xmlns:local="clr-namespace:app.app.Login.View"
             xmlns:vm="clr-namespace:app.app.Login.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800"
             Background="Transparent"
             >


    <Grid >
       
        <Border CornerRadius="20" >
            <Border.Background >
                <ImageBrush ImageSource="../../../res/images/bg1.jpg" Stretch="UniformToFill" x:Name="bg" />
            </Border.Background>
          
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>


                <Grid Grid.Column="1" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1"  Margin="0, 20 ,0, 20">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="0.7*"/>
                                <RowDefinition Height="0.5*"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="0.3*"/>
                                <RowDefinition Height="4*"/>
                                <RowDefinition Height="0.7*"/>
                                <RowDefinition Height="2*"/>

                            </Grid.RowDefinitions>
                            <Grid  Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>

                                <Border BorderThickness="{Binding ClientHighlight}" BorderBrush="White" Grid.Column="1">
                                    <Button Content="Clients" Padding="10,0,10,0" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding SetClientRoleCommand}" FontSize="15"/>
                                </Border>
                                <Border BorderThickness="{Binding AdminHighlight}" BorderBrush="White" Grid.Column="3">
                                    <Button Content="Admins" Padding="10,0,10,0"  Style="{StaticResource NoHoverButtonStyle}" Command="{Binding SetAdminRoleCommand}" FontSize="15"/>
                                </Border>
                            </Grid>


                            <TextBlock Text="{Binding EntryLabel}" Grid.Row="2" Style="{StaticResource EntryTB}"/>
                            <StackPanel Grid.Row="4" Orientation="Vertical" Margin="40, 0, 40, 0">
                                <StackPanel Orientation="Vertical" Height="Auto">
                                    <TextBlock Text="{Binding EmailOrUserName}" Style="{StaticResource ParamTB}"/>
                                    <Border Style="{StaticResource ParamBorder}" >
                                        <TextBox Text="{Binding UserName}" Style="{StaticResource ParamBorderTB}" Foreground="Black" FontWeight="Medium"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Height="{Binding EmailParamHeight}" >
                                    <TextBlock Text="email" Style="{StaticResource ParamTB}"/>
                                    <Border Style="{StaticResource ParamBorder}">
                                        <TextBox Style="{StaticResource ParamBorderTB}" Text="{Binding Email}" Foreground="Black" FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Height="Auto">
                                    <TextBlock Text="password" Style="{StaticResource ParamTB}"/>
                                    <Border Style="{StaticResource ParamBorder}">
                                        <PasswordBox  Style="{StaticResource ParamBorderPB}" PasswordChanged="PasswordBox_PasswordChanged" Foreground="Black" FontWeight="Medium" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <Grid  Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="3*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="10" Margin="0, 5 ,0 ,0" BorderThickness="1.5"   Grid.Column="1"  Style="{StaticResource Hover}">
                                    <Button Content="Log in" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding LogInCommand}"/>
                                </Border>
                                <Border CornerRadius="10" Margin="0, 5 ,0 ,0" BorderThickness="1.5"  Grid.Column="3"  Style="{StaticResource Hover}" >
                                    <Button Content="Sign Up" Style="{StaticResource NoHoverButtonStyle}" Command="{Binding SignUpCommand}"/>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Border Background="white" Opacity="0.1" Height="{Binding DiagHeight}">
            <Border.Effect>
                <BlurEffect Radius="{Binding BgBlur}" KernelType="Gaussian"/>
            </Border.Effect>
            <TextBlock TextWrapping="Wrap" Text="TextBlock"/>
        </Border>

        <Grid Height="{Binding DiagHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="1" Grid.Row="1" Background="#272B2F" CornerRadius="20" Padding="0,20,0,20">
                <Grid>


                    <TextBlock Text="{Binding DiagMessage}" Foreground="White" HorizontalAlignment="Center" Grid.Column="1" FontSize="10" Style="{StaticResource ParamTB}" FontWeight="Thin" TextWrapping="Wrap"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="5*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Column="1" Grid.Row="1" CornerRadius="5" Background="#825ae7" >
                            <Button Content="Ок" Command="{Binding DiagCloseCommand}" Foreground="White" Style="{StaticResource NoHoverButtonStyle}" />
                        </Border>

                    </Grid>
                </Grid>

            </Border>
        </Grid>
    </Grid>
</UserControl>
