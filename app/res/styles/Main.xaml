<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Button" x:Key="NoHoverButtonStyle">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="5, 0, 5, 0"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style TargetType="Border" x:Key="Hover">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="#9C9C9C"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#ED9D2E"/>
                <Setter Property="BorderBrush" Value="#ED9D2E"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock" x:Key="Role">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="EntryTB">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontFamily" Value="pack://application:,,,../fonts/ofont.ru_Nunito.ttf#Nunito"/>
    </Style>
    <Style TargetType="TextBlock" x:Key="ParamTB">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="15,0,0,0"/>
        <Setter Property="FontFamily" Value="pack://application:,,,../fonts/ofont.ru_Nunito.ttf#Nunito"/>
    </Style>
    <Style TargetType="DataGridColumnHeader" x:Key="ColumnStyle">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Margin" Value="15,0,0,0"/>
        <Setter Property="FontFamily" Value="pack://application:,,,../fonts/ofont.ru_Nunito.ttf#Nunito"/>
    </Style>
    <Style TargetType="Border" x:Key="ParamBorder">
        <Setter Property="CornerRadius" Value="15"/>
        <Setter Property="Margin" Value="0, 10, 0, 0"/>
        <Setter Property="Background" Value="#646464"/>
        <Setter  Property="BorderThickness" Value="1.5"/>
    </Style>
    <Style TargetType="TextBox" x:Key="ParamBorderTB">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="15, 5, 15, 5"/>
        <Setter Property="FontWeight" Value="Thin"/>
    </Style>
    <Style TargetType="PasswordBox" x:Key="ParamBorderPB">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="15, 5, 15, 5"/>
        <Setter Property="FontFamily" Value="pack://application:,,,../fonts/ofont.ru_Nunito.ttf#Nunito"/>
        <Setter Property="FontWeight" Value="Thin"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="Padding" Value="0,0,0,5"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Thin"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
